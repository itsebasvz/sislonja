<!doctype html><html lang="es"><head><meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1"><meta name="theme-color" content="#5433eb"><meta name="description" content="Compra lotes completos de pescados y mariscos en Lonja de Veracruz."><meta name="csrf-token" content="<%= csrfToken %>"><title><%= title %> · Lonja Veracruz</title><link rel="icon" href="/icon.svg"><link rel="stylesheet" href="/css/styles.css"><link rel="stylesheet" href="/css/tienda.css"><script src="<%= apiPublica %>/socket.io/socket.io.js" defer></script><script src="/js/direccion.js" defer></script><meta name="socket-url" content="<%= apiPublica %>"><script src="/js/socket.js" defer></script><script src="/js/tienda.js" defer></script></head><body class="shop-body"><a class="skip-link" href="#contenido">Saltar al contenido</a><div class="shop-announcement">DIRECTO DE LA LONJA <span>·</span> Lotes completos. Disponibilidad en tiempo real.</div><header class="shop-header"><a class="brand" href="/"><span class="brand-mark"><%- include('../plantillas/icon',{name:'wave'}) %></span><span>lonja<span class="brand-dot">.</span><small>VERACRUZ</small></span></a><nav aria-label="Principal"><a href="/#catalogo">Explorar lotes</a><a href="/#como-comprar">Cómo comprar</a></nav><div class="shop-header-actions"><% if(user) { %><a class="account-link" href="<%= user.rol==='cliente'?'/mis-pedidos':'/admin' %>"><small>Hola, <%= user.nombre.split(' ')[0] %></small><%= user.rol==='cliente'?'Mis pedidos':'Panel de gestión' %></a><form method="post" action="/cerrar-sesion"><input type="hidden" name="_csrf" value="<%= csrfToken %>"><button class="shop-logout" aria-label="Cerrar sesión">Salir</button></form><% } else { %><a class="account-link" href="/login"><small>Tu cuenta</small>Iniciar sesión</a><% } %></div></header><div class="shop-livebar"><span class="live-indicator"></span><span data-connection>Conectando con la lonja…</span><span>Veracruz, México · Precios en MXN</span></div><main id="contenido" class="shop-main"><div class="shop-toast" role="status" aria-live="polite" hidden></div>
