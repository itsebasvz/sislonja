<article class="lot-card" data-lot="<%= p.id %>">
  <a class="lot-image" href="/tienda/lotes/<%= p.id %>" aria-label="Ver <%= p.nombre %>, lote <%= p.id %>">
    <img src="<%= p.imagen %>" alt="<%= p.nombre %>" loading="lazy">
    <span class="lot-label">Lote #<%= p.id %></span>
  </a>
  <div class="lot-copy">
    <span class="shop-kicker"><%= p.tipo %></span>
    <a href="/tienda/lotes/<%= p.id %>"><h3><%= p.nombre %></h3></a>
    <% if(p.presentacion || p.conservacion){ %><div class="lot-commercial" aria-label="Características del producto"><% for(const value of [p.presentacion,p.conservacion].filter(Boolean)){ %><span><%= value %></span><% } %></div><% } %>
    <dl class="lot-specs" aria-label="Presentación del lote">
      <div><dt>Peso total</dt><dd><%= kilos(p.kilos) %><span>kg</span></dd></div>
      <div><dt>Embalaje</dt><dd><%= p.cajas %><span><%= Number(p.cajas) === 1 ? 'caja' : 'cajas' %></span></dd></div>
    </dl>
    <div class="lot-price"><span class="lot-total-label">Total del lote</span><strong><%= money(p.total) %><span>MXN</span></strong><div class="lot-unit-price"><span>Precio por kg</span><span><%= money(p.precio) %></span></div></div>
    <form class="lot-buy" method="post" action="/tienda/lotes/<%= p.id %>/apartado"><input type="hidden" name="_csrf" value="<%= csrfToken %>"><button class="shop-btn shop-btn-outline" <%= p.disponible ? '' : 'disabled' %>><%= p.estado==='apartado' ? 'Apartado' : 'Comprar' %> <span aria-hidden="true">↗</span></button></form>
  </div>
</article>
