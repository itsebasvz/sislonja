<%- include('plantillas/header') %><a class="back-link" href="/<%= section %>">← Volver a <%= section %></a><section class="page-heading"><div><span class="eyebrow">CADA DETALLE CUENTA</span><h1><%= title %><span class="accent-text">.</span></h1><p><%= section === 'personal' ? 'El nuevo integrante deberá confirmar su correo para acceder.' : 'Completa los datos para mantener tu operación al día.' %></p></div></section><div class="form-layout"><section class="panel form-panel"><%- include('plantillas/errores', { errors }) %><form method="post" action="/<%= section %><%= editing ? '/'+item[cfg.pk || 'id']+'?_method=PUT' : '' %>" class="record-form" <%- section === 'especies' ? 'enctype="multipart/form-data"' : '' %>><input type="hidden" name="_csrf" value="<%= csrfToken %>"><% if(!editing && ['tipos','especies'].includes(section)) { %><%- include('plantillas/catalogo-sugerido') %><% } %><div class="form-grid"><% for (const f of cfg.fields) { const value = f.type === 'password' ? '' : (item[f.name] ?? ''); %><div class="field <%= ['direccion','imagen','descripcion'].includes(f.name) ? 'field-wide' : '' %>"><label for="<%= f.name %>"><%= f.label %><% if (f.optional || (['password','file'].includes(f.type) && editing)) { %><span class="optional">Opcional</span><% } %></label><% if (f.type === 'file') { %><div class="photo-uploader"><div class="photo-preview" <%= value ? '' : 'hidden' %>><img id="foto-preview" <% if(value) { %>src="<%= value %>"<% } %> alt="Vista previa de la fotografía"></div><div class="photo-upload-controls"><input id="imagen" type="file" name="fotografia" accept=".jpg,.jpeg,.png,.webp,.gif,image/jpeg,image/png,image/webp,image/gif" data-max-size="5242880" aria-describedby="foto-ayuda foto-error" <%= editing || item.preset ? '' : 'required' %>><small class="field-help" id="foto-ayuda">JPG, JPEG, PNG, WebP o GIF · Máximo 5 MB.<br><%= editing ? 'Si no seleccionas otra imagen, se conserva la fotografía actual.' : 'Sube una fotografía o utiliza la imagen de la plantilla seleccionada.' %></small><p id="foto-error" class="file-error" role="alert" hidden></p></div></div><% } else if (f.type === 'select') { %><select id="<%= f.name %>" name="<%= f.name %>" required><option value="">Selecciona una opción</option><% for (const option of options[f.name] || []) { %><option value="<%= option.value %>" <%= String(value) === String(option.value) ? 'selected' : '' %>><%= option.label %></option><% } %></select><% } else if (f.name === 'descripcion') { %><textarea id="<%= f.name %>" name="<%= f.name %>" rows="3" maxlength="<%= f.max %>"><%= value %></textarea><% } else { %><input id="<%= f.name %>" name="<%= f.name %>" type="<%= f.type || 'text' %>" <% if(f.suggestions) { %>list="sugerencias-<%= f.name %>"<% } %> value="<%= value %>" <%- !f.optional && !(f.type === 'password' && editing) ? 'required' : '' %> <% if (f.max && f.type !== 'number') { %>maxlength="<%= f.max %>"<% } %> <% if(f.type === 'number') { %>min="<%= f.min %>" max="<%= f.max %>" step="<%= f.step %>"<% } %> <% if(f.type === 'password') { %>autocomplete="new-password" minlength="8" maxlength="72"<% } %>><% if(f.suggestions) { %><datalist id="sugerencias-<%= f.name %>"><% for(const suggestion of f.suggestions) { %><option value="<%= suggestion %>"><% } %></datalist><% } %><% } %><% if(f.help) { %><small class="field-help"><%= f.help %></small><% } %></div><% } %></div><div class="form-actions"><a href="/<%= section %>" class="button button-secondary">Cancelar</a><button class="button button-primary">Guardar <%= cfg.singular %> <%- include('plantillas/icon', { name: 'check' }) %></button></div></form></section><aside class="form-aside"><span class="aside-icon"><%- include('plantillas/icon', { name: section === 'personal' ? 'users' : 'lots' }) %></span><h2>Información que<br>hace la diferencia.</h2><p><%= section === 'lotes' ? 'Registra el peso completo del lote. Una vez vendido, sus datos quedan protegidos.' : section === 'personal' ? 'Solo el administrador puede crear cuentas. La contraseña se guarda cifrada y nunca se muestra.' : 'Los datos correctos facilitan cada venta y mantienen los reportes claros.' %></p><span class="subtle-pill">LONJA DE VERACRUZ</span></aside></div><%- include('plantillas/footer') %>
