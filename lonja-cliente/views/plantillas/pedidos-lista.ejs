<section class="panel order-list"><% if(!rows.length){ %><p class="shop-empty"><%= staff ? 'Todavía no hay pedidos.' : 'No hay pedidos en el período seleccionado.' %> <a href="/">Explorar la tienda →</a></p><% } else { %><div class="table-responsive"><table class="data-table"><thead><tr><th>Folio</th><% if(staff){ %><th>Cliente</th><% } %><% if(!staff){ %><th>Lotes</th><% } %><th>Entrega</th><th>Estado</th><th>Total</th><th></th></tr></thead><tbody><% for(const p of rows){ %><tr><td><strong><%= folio(p) %></strong><small><%= fecha(p.fecha) %> · <%= hora(p.fecha) %></small></td><% if(staff){ %><td><%= nombreComprador(p.comprador) %></td><% } %><% if(!staff){ %><td><%= p.lotes.join(', ') %><small><%= kilos(p.kilos) %> kg</small></td><% } %><td><%= p.entrega==='envio'?'Envío nacional':'Recogida' %></td><td><span class="badge-soft"><%= p.estado %></span></td><td><%= money(!staff && p.estado==='cancelado' ? 0 : p.total) %></td><td><a class="text-link" href="<%= staff?'/pedidos':'/mis-pedidos' %>/<%= p.id %>">Ver pedido ↗</a></td></tr><% } %></tbody></table></div><% } %></section>
