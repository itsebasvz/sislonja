<!doctype html>
<html lang="es"><head><meta charset="utf-8"><meta name="viewport" content="width=device-width, initial-scale=1"><meta name="theme-color" content="#5433eb"><meta name="description" content="Gestión de lotes, compradores y ventas de Lonja de Veracruz."><title><%= title %> · Sistema Lonja</title><link rel="icon" href="/icon.svg" type="image/svg+xml"><link rel="stylesheet" href="/css/styles.css"><script src="<%= apiPublica %>/socket.io/socket.io.js" defer></script><meta name="socket-url" content="<%= apiPublica %>"><script src="/js/socket.js" defer></script><script src="/js/personal.js" defer></script><script src="/js/app.js" defer></script></head>
<body class="<%= user ? 'app-body' : 'auth-body' %>"><a class="skip-link" href="#contenido">Saltar al contenido</a>
<% if (user) { %>
<aside class="sidebar" id="navegacion">
<a href="/admin" class="brand"><span class="brand-mark"><%- include('icon', { name: 'wave' }) %></span><span>lonja<span class="brand-dot">.</span><small>VERACRUZ</small></span></a>
<span class="nav-label">TU ESPACIO DE TRABAJO</span>
<nav aria-label="Navegación principal"><% for (const [url,label,icon] of [['/admin','Vista general','home'],['/pedidos','Pedidos','sales'],['/ventas','Ventas','sales'],['/lotes','Lotes','lots'],['/compradores','Compradores','users'],['/reportes','Reportes','report']]) { %><a href="<%= url + (periodo.aplicado && ['/admin','/ventas','/reportes'].includes(url) ? periodo.query : '') %>" class="nav-item <%= currentPath.startsWith(url) ? 'active' : '' %>" <%- currentPath.startsWith(url) ? 'aria-current="page"' : '' %>><%- include('icon', { name: icon }) %><span><%= label %></span><% if(currentPath.startsWith(url)) { %><span class="nav-active-dot"></span><% } %></a><% } %></nav>
<span class="nav-label nav-label-second">CATÁLOGOS</span>
<nav aria-label="Catálogos"><a class="nav-item <%= currentPath.startsWith('/especies') ? 'active' : '' %>" href="/especies"><%- include('icon', { name: 'fish' }) %>Especies</a><a class="nav-item <%= currentPath.startsWith('/tipos') ? 'active' : '' %>" href="/tipos"><%- include('icon', { name: 'tag' }) %>Tipos de producto</a><% if (user.rol === 'admin') { %><a class="nav-item <%= currentPath.startsWith('/personal') ? 'active' : '' %>" href="/personal"><%- include('icon', { name: 'users' }) %>Personal</a><% } %></nav>
<div class="sidebar-bottom"><div class="local-note"><span class="status-dot"></span> Lonja de Veracruz<small>Del mar a una mejor gestión.</small></div><div class="profile"><span class="avatar"><%= user.nombre.slice(0,1) %></span><span class="profile-info"><span><%= user.nombre %></span><small><%= user.rol === 'admin' ? 'Administrador' : 'Operador' %></small></span><form action="/cerrar-sesion" method="post"><input type="hidden" name="_csrf" value="<%= csrfToken %>"><button class="icon-button" title="Cerrar sesión" aria-label="Cerrar sesión"><%- include('icon', { name: 'exit' }) %></button></form></div></div>
</aside><div class="main-shell"><header class="topbar"><div class="topbar-left"><button class="icon-button mobile-toggle" aria-controls="navegacion" aria-expanded="false" aria-label="Abrir navegación"><%- include('icon', { name: 'menu' }) %></button><span>Sistema Lonja</span><span class="topbar-slash">/</span><span class="topbar-current"><%= title %></span></div><%- include('periodo') %></header>
<main id="contenido" class="page-main">
<% if (aviso) { %><div class="notice" role="status"><%- include('icon', { name: 'check' }) %><span><%= aviso %></span></div><% } %>
<% } else { %><main id="contenido" class="auth-main"><% } %>
