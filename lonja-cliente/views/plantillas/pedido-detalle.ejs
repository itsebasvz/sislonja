<section class="panel order-detail" style="padding:28px;margin-bottom:24px"><div class="section-heading"><h2><%= p.estado==='cancelado'?'Pedido cancelado':p.estado==='entregado'?'Pedido entregado':p.estado==='preparado'?'Listo para entrega':'Preparando tu compra' %></h2><span class="badge-soft"><%= p.estado %></span></div><% if(p.estado==='cancelado'){ %><div class="notice"><span>Devolución ficticia: <%= money(p.total) %> (incluye envío). Motivo: <%= p.motivo %></span></div><% } %><div class="table-responsive"><table class="data-table"><thead><tr><th>Producto</th><th>Kg / cajas</th><th>Precio por kg</th><th>Total</th></tr></thead><tbody><% for(const c of p.compras){const d=c.detalle||{}; %><tr><td><%= d.nombre||c.lote.especie.nombre %><small>Lote #<%= c.id_lte %></small><% if(d.presentacion || d.conservacion){ %><small><%= [d.presentacion,d.conservacion,d.calibre,d.procedencia].filter(Boolean).join(' · ') %></small><% } %></td><td><%= kilos(d.kilos||c.lote.kilos) %> kg · <%= d.cajas||c.lote.numero_cajas %> cajas</td><td><%= money(c.precio_kilo_final) %></td><td><%= money(c.precio_total) %></td></tr><% } %></tbody></table></div><div class="order-info-grid"><div><h3><%= p.entrega==='envio'?'Envío nacional':'Recogida en lonja' %></h3><p><%= p.datos_entrega.nombre %><br><%= p.datos_entrega.telefono %><br><%= p.datos_entrega.correo %></p><% if(p.entrega==='envio'){ %><p><%= p.datos_entrega.calle %> <%= p.datos_entrega.numero %>, <%= p.datos_entrega.colonia %><br>CP <%= p.datos_entrega.cp %>, <%= p.datos_entrega.municipio %><% if(p.datos_entrega.estado){ %>, <%= p.datos_entrega.estado %><% } %> · México</p><% }else{ %><p><%= p.datos_entrega.recogida %><br><%= p.datos_entrega.horario %></p><% } %></div><div><h3>Pago de prueba</h3><p><%= p.metodo==='tarjeta'?p.marca+' •••• '+p.ultimos:'PayPal simulado' %></p><small style="overflow-wrap:anywhere"><%= p.referencia %></small><p>Productos: <%= money(p.subtotal) %><br>Entrega: <%= money(p.envio) %><br><strong>Total: <%= money(p.total) %> MXN</strong></p></div></div><% if(staff&&['pendiente','preparado'].includes(p.estado)){ %><form method="post" action="/pedidos/<%= p.id %>/estado"><input type="hidden" name="_csrf" value="<%= csrfToken %>"><input type="hidden" name="estado" value="<%= p.estado==='pendiente'?'preparado':'entregado' %>"><button class="button button-primary">Marcar como <%= p.estado==='pendiente'?'preparado':'entregado' %></button></form><% if(user.rol==='admin'){ %><details style="margin-top:24px"><summary>Cancelar pedido y liberar lotes</summary><form style="margin-top:16px" method="post" action="/pedidos/<%= p.id %>/estado" data-confirm="¿Cancelar el pedido completo y simular la devolución del total?"><input type="hidden" name="_csrf" value="<%= csrfToken %>"><input type="hidden" name="estado" value="cancelado"><label>Motivo<input name="motivo" minlength="5" maxlength="300" required></label><button class="button button-secondary">Cancelar y devolver <%= money(p.total) %></button></form></details><% } %><% } %></section>
