<%- include('plantillas/header') %><section class="page-heading"><div><span class="eyebrow">UNA MIRADA A LOS RESULTADOS</span><h1><%= title %><span class="accent-text">.</span></h1><p>El detalle de las compras de tus clientes, en un solo informe.</p></div><button class="button button-secondary no-print" data-print><%- include('plantillas/icon', { name: 'print' }) %>Imprimir reporte</button></section><section class="panel report-filters"><form action="/reportes" method="get" class="date-form report-date-range"><div><label for="reporte-desde">Desde</label><input id="reporte-desde" type="date" name="desde" value="<%= periodo.desde %>" max="<%= periodo.actual %>" required></div><div><label for="reporte-hasta">Hasta</label><input id="reporte-hasta" type="date" name="hasta" value="<%= periodo.hasta %>" max="<%= periodo.actual %>" required></div><button class="button button-dark">Consultar <%- include('plantillas/icon', { name: 'arrow' }) %></button></form><span class="muted">Día comercial · Ciudad de México</span></section><section class="stats-grid report-stats"><% for (const [label,value] of [['Ventas registradas',resumen.operaciones],['Kilos vendidos',kilos(resumen.kilos)+' kg'],[periodo.unDia ? 'Importe del día' : 'Importe acumulado',money(resumen.importe)],['Envíos',money(cobros.envio)],['Total cobrado',money(cobros.total)]]) { %><article class="stat-card"><span class="stat-description"><%= label %></span><div class="stat-value"><%= value %></div></article><% } %></section><section class="panel"><div class="section-heading"><div><span class="eyebrow">LONJA DE VERACRUZ</span><h2>Operaciones <%= periodo.unDia ? 'del' : 'del período' %> <%= periodo.etiqueta %></h2></div><span class="badge-soft"><%= rows.length %> ventas</span></div><% if(!rows.length) { %><%- include('plantillas/vacio', { heading: periodo.unDia ? 'Un día sin movimientos' : 'Un período sin movimientos', text: 'No hay ventas registradas para las fechas seleccionadas.' }) %><% } else { %><div class="table-responsive"><table class="data-table report-table"><thead><tr><th>Venta / hora</th><th>Comprador</th><th>Lote / especie / tipo</th><th>Kg / cajas</th><th>Precio / kg</th><th>Importe</th><th>Capturó</th></tr></thead><tbody><% for(const c of rows) { %><tr><td>#<%= c.id_cmp %><small><% if(!periodo.unDia) { %><%= fecha(c.fecha) %> · <% } %><%= hora(c.fecha) %></small></td><td><%= nombreComprador(c.comprador) %></td><td><%= c.lote.especie.nombre %><small>#<%= c.id_lte %> · <%= c.lote.especie.tipo.nombre %></small></td><td><%= kilos(c.lote.kilos) %> kg<small><%= c.lote.numero_cajas %> cajas</small></td><td><%= money(c.precio_kilo_final) %></td><td class="cell-money"><%= money(c.precio_total) %></td><td><%= c.usuario?.nombre || 'Tienda en línea' %></td></tr><% } %></tbody><tfoot><tr><td colspan="3"><%= periodo.unDia ? 'Total del día' : 'Total acumulado' %></td><td><%= kilos(resumen.kilos) %> kg</td><td></td><td class="cell-money"><%= money(resumen.importe) %></td><td></td></tr></tfoot></table></div><% } %></section><%- include('plantillas/footer') %>
