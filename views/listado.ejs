<%- include('plantillas/header') %><section class="page-heading"><div><span class="eyebrow"><%= section === 'personal' ? 'NUESTRO EQUIPO' : section === 'lotes' ? 'PRODUCTO BAJO CONTROL' : 'CADA DETALLE CUENTA' %></span><h1><%= title %><span class="accent-text">.</span></h1><p><%= subtitle %></p></div><% if (editable) { %><a class="button button-primary" href="/<%= section %>/nuevo"><%- include('plantillas/icon', { name: 'plus' }) %><%= cfg.femenino ? 'Nueva' : 'Nuevo' %> <%= cfg.singular %></a><% } %></section>
<% if (section === 'personal' && correoPreview) { %><div class="notice" role="status"><div><strong>Correo de demostración listo</strong><p>Ethereal captura el mensaje; no se envía a una bandeja real. <a href="<%= correoPreview %>" target="_blank" rel="noopener noreferrer">Abrir correo de confirmación ↗</a></p></div></div><% } %><section class="panel list-panel"><div class="list-toolbar"><form class="search-form" method="get" action="/<%= section %>"><span class="search-icon"><%- include('plantillas/icon', { name: 'search' }) %></span><input name="q" type="search" aria-label="Buscar en <%= title %>" placeholder="<%= section === 'lotes' ? 'Buscar por lote o especie…' : 'Buscar por nombre'+ (['personal','compradores'].includes(section) ? ' o correo…' : '…') %>" value="<%= q %>"><% if (section === 'lotes') { %><select name="estado" aria-label="Disponibilidad"><option value="">Todos los estados</option><option value="disponible" <%= estado === 'disponible' ? 'selected' : '' %>>Disponibles</option><option value="vendido" <%= estado === 'vendido' ? 'selected' : '' %>>Vendidos</option></select><% } %><button class="button button-secondary">Buscar</button><% if (q || estado) { %><a class="text-link" href="/<%= section %>">Limpiar</a><% } %></form><span class="results-count"><%= rows.length %> registros</span></div>
<% if (!rows.length) { %><%- include('plantillas/vacio', { heading: q || estado ? 'No encontramos resultados' : 'Aquí comienza tu catálogo', text: q || estado ? 'Prueba otra búsqueda o cambia los filtros.' : 'Agrega el primer registro para comenzar.' }) %><% } else { %><div class="table-responsive"><table class="data-table"><thead><tr><% for (const col of cfg.columns) { %><th><%= col %></th><% } %><% if (editable || section === 'lotes') { %><th class="text-end">Acciones</th><% } %></tr></thead><tbody><% for (const row of rows) { const id = row[cfg.pk]; %><tr>
<% if (section === 'tipos') { %><td><span class="muted">#<%= id %></span></td><td><span class="cell-title"><%= row.nombre %></span><% const referencia=tiposBase.find(t=>t.nombre===row.nombre);if(referencia){ %><small><%= referencia.descripcion %></small><% } %></td>
<% } else if (section === 'especies') { %><td><div class="product-cell"><img src="<%= row.imagen %>" alt=""><span><span class="cell-title"><%= row.nombre %></span><small>Especie #<%= id %></small></span></div></td><td><span class="badge-soft"><%= row.tipo.nombre %></span></td>
<% } else if (section === 'compradores') { %><td><div class="person-cell"><span class="avatar avatar-small"><%= row.nombre.slice(0,1) %></span><span><span class="cell-title"><%= nombreComprador(row) %></span><small>Comprador #<%= id %></small></span></div></td><td><%= row.correo %></td><td class="address-cell"><%= row.direccion %></td>
<% } else if (section === 'personal') { %><td><div class="person-cell"><span class="avatar avatar-small"><%= row.nombre.slice(0,1) %></span><span><span class="cell-title"><%= row.nombre %> <%= row.apellido %></span><small>Integrante #<%= id %></small></span></div></td><td><%= row.email %></td><td><%= row.rol === 'admin' ? 'Administrador' : 'Operador' %></td><td><span class="badge-soft <%= row.confirmar ? 'badge-available' : '' %>"><%= row.confirmar ? 'Confirmado' : 'Sin confirmar' %></span></td>
<% } else if (section === 'lotes') { %><td><div class="product-cell"><img src="<%= row.especie.imagen %>" alt=""><span><span class="cell-title"><%= row.especie.nombre %></span><small>Lote #<%= id %> · <%= row.especie.tipo.nombre %></small><% if(row.presentacion || row.conservacion) { %><small><%= [row.presentacion,row.conservacion].filter(Boolean).join(' · ') %></small><% } %></span></div></td><td><span class="cell-title"><%= kilos(row.kilos) %> kg</span><small><%= row.numero_cajas %> cajas</small></td><td><%= money(row.precio_kilo_salida) %><small>por kilogramo</small></td><td><%= fecha(row.fecha) %></td><td><span class="badge-soft <%= row.compra ? '' : 'badge-available' %>"><span class="status-dot"></span><%= row.compra ? 'Vendido' : 'Disponible' %></span></td><% } %>
<% if (editable || section === 'lotes') { %><td><div class="row-actions"><% if (section === 'personal' && !row.confirmar) { %><form action="/personal/<%= id %>/confirmacion" method="post"><input type="hidden" name="_csrf" value="<%= csrfToken %>"><button class="icon-button" title="Reenviar confirmación" aria-label="Reenviar confirmación a <%= row.nombre %>"><%- include('plantillas/icon', { name: 'mail' }) %></button></form><% } %><% if (editable && !(section === 'lotes' && row.compra)) { %><a class="icon-button" href="/<%= section %>/<%= id %>/editar" title="Editar" aria-label="Editar registro <%= id %>"><%- include('plantillas/icon', { name: 'edit' }) %></a><% if (!(section === 'personal' && row.rol === 'admin')) { %><form action="/<%= section %>/<%= id %>?_method=DELETE" method="post" data-confirm="¿Eliminar este registro? Esta acción no se puede deshacer."><input type="hidden" name="_csrf" value="<%= csrfToken %>"><button class="icon-button delete-button" title="Eliminar" aria-label="Eliminar registro <%= id %>"><%- include('plantillas/icon', { name: 'trash' }) %></button></form><% } %><% } %></div></td><% } %></tr><% } %></tbody></table></div><% } %></section><%- include('plantillas/footer') %>
