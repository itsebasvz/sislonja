<%- include('plantillas/header') %>
<section class="page-heading"><div><span class="eyebrow">TU OPERACIÓN, AL DÍA</span><h1><%= periodo.esHoy ? 'Todo listo para un buen día' : 'El histórico de tu operación' %><span class="accent-text">.</span></h1><p>Hola, <%= user.nombre.split(' ')[0] %>. <%= periodo.esHoy ? 'Este es el pulso de la lonja hoy.' : 'Consulta los resultados del período seleccionado.' %></p></div><a class="button button-primary" href="/pedidos"><%- include('plantillas/icon', { name: 'plus' }) %>Ver pedidos</a></section>
<% if (!periodo.esHoy) { %><div class="period-summary"><span><%- include('plantillas/icon', { name: 'calendar' }) %> <%= periodo.etiqueta %></span><a href="/admin">Volver a hoy ↗</a></div><% } %><section class="stats-grid" aria-label="Resumen del período seleccionado"><% for (const [label,value,desc,icon] of [[periodo.esHoy ? 'Ventas de hoy' : 'Ventas del período',money(resumen.importe),periodo.unDia ? 'Importe total del día' : 'Importe acumulado','sales'],[periodo.esHoy ? 'Lotes disponibles' : 'Lotes al cierre',disponibles,periodo.esHoy ? 'Listos para su venta' : 'Disponibles al final del período','lots'],['Kilos vendidos',kilos(resumen.kilos)+' kg',resumen.operaciones+' operaciones registradas','fish'],['Compradores',compradores,'Con compras en el período','users']]) { %><article class="stat-card"><div class="stat-top"><span><%= label %></span><span class="stat-icon"><%- include('plantillas/icon', { name: icon }) %></span></div><div class="stat-value"><%= value %></div><span class="stat-description"><%= desc %></span></article><% } %></section>
<section class="dashboard-feature"><div class="feature-copy"><span class="eyebrow">FRESCO. DISPONIBLE. A TIEMPO.</span><h2>Del muelle a<br>la siguiente venta.</h2><p>Consulta los lotes disponibles y encuentra<br class="desktop-only"> el producto para tu próximo comprador.</p><a class="button button-dark" href="/lotes?estado=disponible">Explorar lotes <%- include('plantillas/icon', { name: 'arrow' }) %></a></div><div class="feature-image"><img src="/img/especies/pescado.jpg" alt="Pescado fresco de la lonja"><span class="image-label"><span class="status-dot"></span> Calidad que viene del mar</span></div></section>
<section class="dashboard-bottom"><article class="panel recent-panel"><div class="section-heading"><div><span class="eyebrow"><%= periodo.esHoy ? 'MOVIMIENTO DEL DÍA' : 'MOVIMIENTO DEL PERÍODO' %></span><h2>Últimas ventas</h2></div><a class="text-link" href="/ventas<%= periodo.query %>">Ver todas <%- include('plantillas/icon', { name: 'arrow' }) %></a></div><% if (!recientes.length) { %><%- include('plantillas/vacio', { heading: periodo.esHoy ? 'El día está por comenzar' : 'Sin movimientos en este período', text: periodo.esHoy ? 'Las ventas que registres hoy aparecerán aquí.' : 'Prueba otra fecha o amplía el rango seleccionado.' }) %><% } else { %><div class="table-responsive"><table class="data-table"><thead><tr><th>Comprador</th><th>Producto</th><th class="text-end">Importe</th></tr></thead><tbody><% for (const c of recientes) { %><tr><td><div class="person-cell"><span class="avatar avatar-small"><%= c.comprador.nombre.slice(0,1) %></span><span><span class="cell-title"><%= nombreComprador(c.comprador) %></span><small><% if (!periodo.esHoy) { %><%= fecha(c.fecha) %> · <% } %><%= hora(c.fecha) %> · Venta #<%= c.id_cmp %></small></span></div></td><td><span class="cell-title"><%= c.lote.especie.nombre %></span><small><%= kilos(c.lote.kilos) %> kg</small></td><td class="text-end cell-money"><%= money(c.precio_total) %></td></tr><% } %></tbody></table></div><% } %></article><article class="panel available-panel"><div class="section-heading"><div><span class="eyebrow">EN LA LONJA</span><h2>Disponibles ahora</h2></div><a class="icon-button" href="/lotes" aria-label="Ver todos los lotes"><%- include('plantillas/icon', { name: 'arrow' }) %></a></div><% if (!lotes.length) { %><%- include('plantillas/vacio', { heading: 'Todo vendido', text: 'Registra nuevos lotes para continuar.' }) %><% } %><% for (const l of lotes) { %><a class="available-product" href="/tienda/lotes/<%= l.id_lte %>"><img src="<%= l.especie.imagen %>" alt=""><span><span class="cell-title"><%= l.especie.nombre %></span><small>Lote #<%= l.id_lte %> · <%= kilos(l.kilos) %> kg</small></span><span class="product-price"><%= money(l.precio_kilo_salida) %><small>/ kg</small></span></a><% } %><div class="available-footer"><span class="status-dot"></span> Lotes completos, listos para salir.</div></article></section><%- include('plantillas/footer') %>
