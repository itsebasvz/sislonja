<details class="date-picker" data-date-picker>
<summary class="topbar-date" aria-label="Seleccionar fecha o rango del histórico"><%- include('icon', { name: 'calendar' }) %><span><%= currentPath === '/ventas' && !periodo.aplicado ? 'Todas las fechas' : periodo.etiqueta %></span><%- include('icon', { name: 'chevron' }) %></summary>
<div class="date-popover"><div class="date-popover-heading"><span class="eyebrow">EXPLORA TU HISTÓRICO</span><h2>Elige un período</h2><p>Consulta un día o selecciona un rango.</p></div>
<div class="date-shortcuts"><% for (const p of periodo.atajos) { %><button type="button" data-date-preset data-desde="<%= p.desde %>" data-hasta="<%= p.hasta %>"><%= p.nombre %></button><% } %></div>
<form method="get" action="<%= ['/admin','/ventas','/reportes'].includes(currentPath) ? currentPath : '/admin' %>" data-period-form>
<div class="date-inputs"><div class="field"><label for="periodo-desde">Desde</label><input id="periodo-desde" type="date" name="desde" value="<%= periodo.desde %>" max="<%= periodo.actual %>" required></div><div class="field"><label for="periodo-hasta">Hasta</label><input id="periodo-hasta" type="date" name="hasta" value="<%= periodo.hasta %>" max="<%= periodo.actual %>" required></div></div>
<div class="inline-calendar" data-calendar><div class="calendar-heading"><button type="button" class="icon-button" data-prev-month aria-label="Mes anterior">‹</button><span data-calendar-month aria-live="polite"></span><button type="button" class="icon-button" data-next-month aria-label="Mes siguiente">›</button></div><div class="calendar-week" aria-hidden="true"><span>L</span><span>M</span><span>M</span><span>J</span><span>V</span><span>S</span><span>D</span></div><div class="calendar-grid" data-calendar-days aria-label="Días del mes"></div></div>
<p class="calendar-help" data-calendar-help aria-live="polite">Selecciona un día; pulsa otro para ampliar el rango.</p><div class="date-popover-actions"><button class="button button-secondary" type="button" data-close-period>Cancelar</button><button class="button button-primary">Aplicar período <%- include('icon', { name: 'arrow' }) %></button></div>
</form></div></details>
