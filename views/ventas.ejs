<%- include('plantillas/header') %><section class="page-heading"><div><span class="eyebrow">OPERACIÓN COMERCIAL</span><h1>Ventas<span class="accent-text">.</span></h1><p><%= subtitle %></p></div></section><section class="panel list-panel"><div class="list-toolbar"><form class="search-form" action="/ventas" method="get"><span class="search-icon"><%- include('plantillas/icon', { name: 'search' }) %></span><input type="search" name="q" value="<%= q %>" aria-label="Buscar ventas" placeholder="Buscar por comprador, producto o venta…"><button class="button button-secondary">Buscar</button><% if(q) { %><a class="text-link" href="/ventas">Limpiar</a><% } %></form><span class="results-count"><%= rows.length %> ventas</span></div><% if (!rows.length) { %><%- include('plantillas/vacio', { heading: 'Cada venta empieza aquí', text: 'Las compras de la tienda aparecerán aquí.' }) %><% } else { %><div class="table-responsive"><table class="data-table"><thead><tr><th>Venta</th><th>Comprador</th><th>Lote / producto</th><th>Precio / kg</th><th>Total</th><th>Capturó</th></tr></thead><tbody><% for(const c of rows) { %><tr><td><span class="cell-title">#<%= c.id_cmp %></span><small><%= fecha(c.fecha) %> · <%= hora(c.fecha) %></small></td><td><%= nombreComprador(c.comprador) %></td><td><span class="cell-title"><%= c.lote.especie.nombre %></span><small>Lote #<%= c.id_lte %> · <%= kilos(c.lote.kilos) %> kg</small></td><td><%= money(c.precio_kilo_final) %></td><td class="cell-money"><%= money(c.precio_total) %></td><td><%= c.usuario?.nombre || 'Tienda en línea' %></td></tr><% } %></tbody></table></div><% } %></section><%- include('plantillas/footer') %>
